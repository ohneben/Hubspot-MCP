# =====================================================================
# HubSpot MCP — copy this file to `.env` and fill in the required value
# below. `.env` is git-ignored — never commit real secrets.
# =====================================================================

# ─── Required: HubSpot credentials ───────────────────────────────────
# A service key (recommended): HubSpot → Settings → Integrations →
# Service Keys. A legacy private app token works the same way. Both look
# like "pat-na1-…". Service keys do not support GraphQL, so set
# HUBSPOT_ENABLE_GRAPHQL=false when using one. The scopes you select decide
# which tools work -
# run the hubspot_get_capabilities tool anytime to see what's unlocked.
# (An OAuth access token also works, but expires after ~30 minutes and
# is not refreshed by this server.)
HUBSPOT_ACCESS_TOKEN=pat-na1-your-token

# API host. Leave the default unless your portal is in HubSpot's EU data
# center — then use https://api-eu1.hubapi.com
HUBSPOT_BASE_URL=https://api.hubapi.com

# ─── Optional: transport ─────────────────────────────────────────────
# "stdio" (Claude Desktop / local launchers) or "http" (hosted / Docker).
# The Docker image defaults to http.
MCP_TRANSPORT=http

# HTTP transport settings (ignored for stdio).
PORT=8765
HOST=0.0.0.0
MCP_HTTP_PATH=/mcp

# Bearer token required on the HTTP endpoint. The server refuses to start
# without one whenever HOST is not a loopback address, because this endpoint can
# read, write and delete across the whole HubSpot account. Generate one with:
#   openssl rand -hex 32
# Renamed from MCP_SHARED_TOKEN in 1.1.0.
MCP_AUTH_TOKEN=

# Hostnames the Host header may carry, comma separated. Leave empty to let the
# server derive it: the loopback names on a loopback bind, no check behind a
# reverse proxy. Set it when a probe reaches the container by service name.
MCP_ALLOWED_HOSTS=

# Start without a token on a non-loopback bind. Only for a port that genuinely
# is not reachable by anyone else.
MCP_ALLOW_INSECURE=

# Largest accepted request body, e.g. 25mb / 512kb / a plain byte count.
MCP_BODY_LIMIT=25mb

# Seconds an idle session is kept before the sweep drops it.
MCP_SESSION_TTL=1800

# Concurrent sessions before the least recently used one is evicted.
MCP_MAX_SESSIONS=256

# ─── Optional: resilience & throttling ───────────────────────────────
# HubSpot burst limits are per 10-second window (private apps: 100/10s on
# Free/Starter, 150/10s on Pro/Enterprise, more with the API add-on; OAuth
# apps ~110/10s). The server self-throttles at the tightest common cap.
# Set MAX_REQUESTS=0 to disable client-side throttling entirely (retries
# still cover 429s).
HUBSPOT_MAX_REQUESTS=100
HUBSPOT_RATE_WINDOW_MS=10000

# The CRM /search endpoints have their own ~5 req/s cap per token — the
# server throttles them separately a touch under that.
HUBSPOT_SEARCH_MAX_REQUESTS=4
HUBSPOT_SEARCH_RATE_WINDOW_MS=1000

# Automatic retries on 429 / 5xx / network errors (honors Retry-After).
HUBSPOT_MAX_RETRIES=3

# Per-attempt request timeout in milliseconds.
HUBSPOT_TIMEOUT_MS=30000

# ─── Optional: tool-surface controls ─────────────────────────────────
# The server exposes ~1,079 tools by default. Narrow that per deployment:
#
# Only expose these groups — group keys (see `npm run list-tools`) and/or
# area wildcards (crm:*, cms:*, marketing:*, …):
# HUBSPOT_INCLUDE_GROUPS=contacts,companies,deals,tickets,lists,properties
#
# Hide these groups (same syntax):
# HUBSPOT_EXCLUDE_GROUPS=cms:*,media-bridge
#
# Read-only mode: expose ONLY 🟢 read-only tools — every write/destructive
# tool (and the raw-request escape hatch) is hidden. Great for
# analytics/reporting deployments.
HUBSPOT_READ_ONLY=false

# Include beta / developer-preview APIs (labelled ⚠️ in descriptions).
HUBSPOT_INCLUDE_BETA=true

# "all" = one tool per endpoint (default). "discovery" = 3 meta-tools
# (search / inspect / invoke over the same registry) for clients that
# prefer a tiny tool list. All filters above still apply.
HUBSPOT_TOOL_MODE=all

# Expose the CRM GraphQL query tool (query-only — needs the
# collector.graphql_query.execute scope and Marketing/Content Hub Pro+).
HUBSPOT_ENABLE_GRAPHQL=true
# Override the GraphQL endpoint if needed (defaults to <base>/collector/graphql):
# HUBSPOT_GRAPHQL_URL=

# Expose hubspot_api_request — the raw escape hatch for brand-new/beta
# endpoints. Automatically hidden in read-only mode.
HUBSPOT_ENABLE_RAW_REQUEST=true

# Truncate any single tool response longer than this many characters, so one
# huge list can't swamp the model's context. 0 = never truncate.
HUBSPOT_MAX_RESPONSE_CHARS=0

# ─── Optional: override the bundled specs ────────────────────────────
# Point at a directory containing your own spec JSON files + catalog.json
# (generate one with `npm run fetch-specs`). Only set this to test a newer
# API definition without rebuilding the image.
# HUBSPOT_SPEC_DIR=/abs/path/to/spec
